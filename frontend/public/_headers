# Headers para Cloudflare Pages (y cualquier host que lea _headers del
# publish dir — Netlify tambien lo hace, y son los MISMOS valores que ya
# declara netlify.toml, asi que conviven sin pisarse).
#
# auto-update-kit: el HTML de arranque, el Service Worker y el manifiesto de
# version NUNCA se cachean — es lo que hace que un deploy nuevo se vea sin
# hard refresh y sin reinstalar la PWA (regla de base-compartida/6-GUIA-PWA).

/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-store, max-age=0, must-revalidate

/index.html
  Cache-Control: no-store, max-age=0, must-revalidate

/version.json
  Cache-Control: no-store, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

# El SW y el manifest de /calls: mismo criterio no-store que los de la app
# (un SW cacheado es un SW que no se actualiza nunca).
/calls/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

/calls/manifest.json
  Cache-Control: no-store, max-age=0, must-revalidate

/calls/
  Cache-Control: no-store, max-age=0, must-revalidate
